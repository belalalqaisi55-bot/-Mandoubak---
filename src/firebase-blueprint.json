{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Represents a pharmaceutical product in the catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "string" },
        "unit": { "type": "string" },
        "bonus": { "type": "string" },
        "activeIngredient": { "type": "string" },
        "image": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of all products in the catalog."
    }
  }
}

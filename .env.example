# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user se⁷crets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_WEBHOOK_SECRET: Signing secret generated by Google GenAI client.webhooks.create (webhook.new_signing_secret)
GEMINI_WEBHOOK_SECRET=


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_SECRET: The secret passcode required to authenticate as admin and send notifications.
ADMIN_SECRET="Mandoubk302344$"

# Google Maps Platform API Key (or Demo Key)
VITE_GOOGLE_MAPS_API_KEY=

# OpenRouter API Key for multi-model AI access (DeepSeek, Claude, Llama, etc.)
OPENROUTER_API_KEY=

# OpenRouter Workspace ID (Default: 21aaba5e-2929-5ce8-a166-d464aaf42366)
OPENROUTER_WORKSPACE_ID="21aaba5e-2929-5ce8-a166-d464aaf42366"

# reCAPTCHA v3 Public Site Key for Firebase App Check
VITE_RECAPTCHA_SITE_KEY="6Leav78tAAAAAIC55RH3TEYNvLaxhbN0JQ6YzgYf"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ais-pre-oqwx6mdzcwvrhadryzbxjt-13849160368.europe-west1.run.app/auth/google/callback
FRONTEND_ORIGIN=https://ais-pre-oqwx6mdzcwvrhadryzbxjt-13849160368.europe-west1.run.app
SESSION_SECRET=a-very-secret-string
